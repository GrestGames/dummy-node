{
  "services": {
    "server": {
      "dir": "server",
      "command": "npm run dev",
      "port": 9000
    },
    "client": {
      "dir": "client",
      "command": "npm run dev",
      "port": 3000
    }
  },
  "setup": {                                                                                                                                                                                                                                               
      "steps": [                                                                                                                                                                                                                                               
        {                                                                                                                                                                                                                                                    
          "name": "marker_kratt",                                                                                                                                                                                                                              
          "run": "echo kratt > /workspace/tmp_from_setup && id -un >> /workspace/tmp_from_setup"
        },                                                                                                                                                                                                                                                     
        {                                                                                                                                                                                                                                                    
          "name": "marker_root",
          "run": "apt-get install -y -qq jq",                                                                                                                                                                                                                  
          "sudo": true                    
        }                                                                                                                                                                                                                                                      
      ]                                                                                                                                                                                                                                                        
    }
}
