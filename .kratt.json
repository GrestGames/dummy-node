{
    "steps": [
      {"kind": "bash:setup", "bash": "npm install"},
      {"kind": "bash:setup", "bash": "echo kratt > /workspace/tmp_from_setup && id -un >> /workspace/tmp_from_setup"},
      {"kind": "bash:setup", "bash": "apt-get install -y -qq jq", "sudo": true},
      {"kind": "bash:up",   "bash": "date +%s.%N >> /workspace/tmp_from_up"},
      {"kind": "backend",  "name": "server", "dir": "server", "bash": "npm run dev", "port": 9000, "expose": "api"},
      {"kind": "frontend", "name": "client", "dir": "client", "bash": "npm run dev", "port": 3000, "expose": "web"},
      {"kind": "bash:setup", "bash": "echo finalize > /workspace/tmp_from_finalize && id -un >> /workspace/tmp_from_finalize"},
      {"kind": "bash:down", "bash": "date +%s.%N >> /workspace/tmp_from_down"}
    ]
  }
